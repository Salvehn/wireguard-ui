{
  "name": "wireguard-ui",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run prepare:helper && vite build && electron .",
    "build": "npm run check:architecture && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test electron/*.test.cjs",
    "package": "npm run prepare:helper && npm run build && electron-builder --mac dir",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "dist:mac": "npm run prepare:helper && npm run build && electron-builder --mac dmg zip --arm64",
    "release:mac": "node scripts/release-mac.mjs",
    "update:keygen": "node scripts/generate-update-key.mjs",
    "update:manifest": "node scripts/generate-update-manifest.mjs",
    "prepare:helper": "node scripts/prepare-helper.mjs",
    "test:release": "node --test scripts/release-utils.test.mjs"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "local.wireguard.ui",
    "productName": "WireGuard Desktop",
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "electron/update-public-key.pem",
      "src/shared/lib/i18n/en.json",
      "!electron/*.test.cjs",
      "assets/wireguard.icns"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/wireguard.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "WireGuard-Desktop-${arch}.${ext}",
    "dmg": {
      "title": "WireGuard Desktop",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 180,
          "y": 205
        },
        {
          "x": 480,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/helper",
        "to": "helper"
      }
    ],
    "afterPack": "scripts/verify-packaged-helper.cjs"
  },
  "description": "Compact local WireGuard desktop client"
}
